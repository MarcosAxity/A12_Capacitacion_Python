# Copiar a .env y ajustar valores para desarrollo local.
# Todas las variables usan el prefijo ORDERS_ (ver infrastructure/config.py).

ORDERS_DATABASE_URL=sqlite+aiosqlite:///./orders.db
ORDERS_JWT_SECRET_KEY=change-me-in-production-please-use-32-bytes-min
ORDERS_JWT_ALGORITHM=HS256
ORDERS_JWT_EXPIRE_MINUTES=30
ORDERS_ENVIRONMENT=development
ORDERS_LOG_LEVEL=INFO
ORDERS_CORS_ORIGINS=["*"]
ORDERS_SQL_ECHO=false
